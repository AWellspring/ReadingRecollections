<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.userinterface.ViewBooksActivity">

    <!-- Small banner image -->
    <ImageView
        android:id="@+id/banner_image"
        android:layout_width="300dp"
        android:layout_height="125dp"
        android:layout_marginBottom="16dp"
        app:srcCompat="@drawable/reading_recollections_banner"
        app:layout_constraintBottom_toTopOf="@+id/recycler_view_books"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- RecyclerView to display books retrieved from database.
         Styled in item_book.xml -->
    <androidx.recyclerview.widget.RecyclerView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:id="@+id/recycler_view_books"
        app:layout_constraintTop_toBottomOf="@+id/banner_image"
        app:layout_constraintBottom_toTopOf="@+id/add_book_button"
        app:layout_constraintBottom_toBottomOf="parent"
        android:padding="16dp"
        android:scrollbars="vertical"
        android:fadeScrollbars="false"/>

    <!-- Button to add a book -->
    <Button
        android:id="@+id/add_book_button"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="20dp"
        android:text="Add a Book"
        android:textSize="30sp"
        android:textAllCaps="false"
        android:background="@drawable/rounded_button"
        android:elevation="4dp"
        android:layout_marginTop="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>