<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.HomeActivity">

    <!-- Small banner image -->
    <ImageView
        android:id="@+id/banner_image"
        android:layout_width="300dp"
        android:layout_height="125dp"
        android:layout_marginBottom="16dp"
        app:srcCompat="@drawable/reading_recollections_banner"
        app:layout_constraintBottom_toTopOf="@+id/add_author_button"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Add author button -->
    <Button
        android:id="@+id/add_author_button"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="20dp"
        android:textSize="30sp"
        android:textAllCaps="false"
        android:text="Add an author"
        android:background="@drawable/rounded_button"
        android:elevation="4dp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/banner_image"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Add book button -->
    <Button
        android:id="@+id/add_book_button"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="20dp"
        android:textSize="30sp"
        android:textAllCaps="false"
        android:text="Add a book"
        android:background="@drawable/rounded_button"
        android:elevation="4dp"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/add_author_button"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- View all authors button -->
    <Button
        android:id="@+id/view_all_authors_button"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="20dp"
        android:textSize="30sp"
        android:textAllCaps="false"
        android:text="View all authors"
        android:background="@drawable/rounded_button"
        android:elevation="4dp"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/add_book_button"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- View all books button -->
    <Button
        android:id="@+id/view_all_books_button"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="20dp"
        android:textSize="30sp"
        android:textAllCaps="false"
        android:text="View all books"
        android:background="@drawable/rounded_button"
        android:elevation="4dp"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/view_all_authors_button"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Search button -->
    <Button
        android:id="@+id/search_button"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="20dp"
        android:textSize="30sp"
        android:textAllCaps="false"
        android:text="Search"
        android:background="@drawable/rounded_button"
        android:elevation="4dp"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/view_all_books_button"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>