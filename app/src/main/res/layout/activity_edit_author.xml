<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.userinterface.EditAuthorActivity">

    <!-- Home Button -->
    <ImageButton
        android:id="@+id/home_button"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:padding="8dp"
        android:background="@drawable/home_button"
        android:scaleType="fitCenter"
        android:elevation="4dp"
        app:srcCompat="@drawable/home_icon"
        app:layout_constraintTop_toTopOf="@id/banner_image"
        app:layout_constraintBottom_toBottomOf="@id/banner_image"
        app:layout_constraintEnd_toStartOf="@id/banner_image"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginStart="30dp"/>

    <!-- Small banner image -->
    <ImageView
        android:id="@+id/banner_image"
        android:layout_width="300dp"
        android:layout_height="125dp"
        android:layout_marginBottom="16dp"
        app:srcCompat="@drawable/reading_recollections_banner"
        app:layout_constraintBottom_toTopOf="@+id/input_scroll_view"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Scrollable section for input fields -->
    <ScrollView
        android:id="@+id/input_scroll_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginBottom="8dp"
        app:layout_constraintTop_toBottomOf="@id/banner_image"
        app:layout_constraintBottom_toTopOf="@id/update_author_button"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:scrollbars="vertical"
        android:fadeScrollbars="false">

    <!-- Wrapper LinearLayout to contain all input fields -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

    <!-- Text view with an editable field for the Author First Name string
        Formatted so the EditText is aligned horizontally with the TextView -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:id="@+id/input_first_name_field"
        app:layout_constraintTop_toBottomOf="@+id/banner_image">

        <TextView
            android:id="@+id/label_author_first_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="First Name: "
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:padding="10dp"/>

        <!-- TextInputLayout wrapped around the EditText for validation messages and prompts -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/author_first_name_input_layout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="10dp"
            app:hintEnabled="true"
            android:paddingEnd="10dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/author_first_name_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="First Name"
                android:textSize="20sp"
                android:inputType="text"
                android:gravity="end"/>
        </com.google.android.material.textfield.TextInputLayout>
    </LinearLayout>

    <!-- Text view with an editable field for the Author Middle Name string
        Formatted so the EditText is aligned horizontally with the TextView -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:id="@+id/input_middle_name_field"
        app:layout_constraintTop_toBottomOf="@+id/input_first_name_field">

        <TextView
            android:id="@+id/label_author_middle_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Middle Name: "
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:padding="10dp"/>

        <!-- TextInputLayout wrapped around the EditText for validation messages and prompts -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/author_middle_name_input_layout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="10dp"
            app:hintEnabled="true"
            android:paddingEnd="10dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/author_middle_name_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Middle Name (Optional)"
                android:textSize="20sp"
                android:inputType="text"
                android:gravity="end"/>
        </com.google.android.material.textfield.TextInputLayout>
    </LinearLayout>

    <!-- Text view with an editable field for the Author Last Name string
        Formatted so the EditText is aligned horizontally with the TextView -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:id="@+id/input_text_field"
        app:layout_constraintTop_toBottomOf="@+id/input_middle_name_field">

        <TextView
            android:id="@+id/label_author_last_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Last Name: "
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:padding="10dp"/>

        <!-- TextInputLayout wrapped around the EditText for validation messages and prompts -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/author_last_name_input_layout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="10dp"
            app:hintEnabled="true"
            android:paddingEnd="10dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/author_last_name_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Last Name"
                android:textSize="20sp"
                android:inputType="text"
                android:gravity="end"/>
        </com.google.android.material.textfield.TextInputLayout>
    </LinearLayout>
    </LinearLayout>
    </ScrollView>

    <!-- Button to update author in database -->
    <Button
        android:id="@+id/update_author_button"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="20dp"
        android:text="Update Author"
        android:textSize="30sp"
        android:textAllCaps="false"
        android:background="@drawable/rounded_button"
        android:elevation="4dp"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/input_scroll_view"
        app:layout_constraintBottom_toTopOf="@id/delete_author_button"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Button to delete author from database -->
    <Button
        android:id="@+id/delete_author_button"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="20dp"
        android:text="Delete Author"
        android:textSize="30sp"
        android:textAllCaps="false"
        android:background="@drawable/rounded_button"
        android:elevation="4dp"
        android:layout_marginTop="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>