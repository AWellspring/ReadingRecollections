<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.userinterface.AddBookActivity">

    <!-- Home Button -->
    <ImageButton
        android:id="@+id/home_button"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:padding="8dp"
        android:background="@drawable/home_button"
        android:scaleType="fitCenter"
        android:elevation="4dp"
        app:srcCompat="@drawable/home_icon"
        app:layout_constraintTop_toTopOf="@id/banner_image"
        app:layout_constraintBottom_toBottomOf="@id/banner_image"
        app:layout_constraintEnd_toStartOf="@id/banner_image"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginStart="30dp"/>

    <!-- Small banner image -->
    <ImageView
        android:id="@+id/banner_image"
        android:layout_width="300dp"
        android:layout_height="125dp"
        android:layout_marginBottom="16dp"
        app:srcCompat="@drawable/reading_recollections_banner"
        app:layout_constraintBottom_toTopOf="@+id/input_scroll_view"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Scrollable section for input fields -->
    <ScrollView
        android:id="@+id/input_scroll_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginBottom="8dp"
        app:layout_constraintTop_toBottomOf="@id/banner_image"
        app:layout_constraintBottom_toTopOf="@id/save_book_button"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:scrollbars="vertical"
        android:fadeScrollbars="false">

    <!-- Wrapper LinearLayout to contain all input fields -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

    <!-- Text view with an editable field for the Book Title string
        Formatted so the EditText is aligned horizontally with the TextView -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:id="@+id/input_title_field"
        app:layout_constraintTop_toBottomOf="@+id/banner_image">

        <TextView
            android:id="@+id/label_book_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Book Title: "
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:padding="10dp"/>

        <!-- TextInputLayout wrapped around the EditText for validation messages and prompts -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/book_title_input_layout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="10dp"
            app:hintEnabled="true"
            android:paddingEnd="10dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/book_title_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Title"
                android:textSize="20sp"
                android:inputType="text"
                android:gravity="end"/>
        </com.google.android.material.textfield.TextInputLayout>
    </LinearLayout>

    <!-- Text view with an editable field for the Author Name string
        Formatted so the EditText is aligned horizontally with the TextView -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:id="@+id/input_author_field"
        app:layout_constraintTop_toBottomOf="@+id/input_title_field">

        <TextView
            android:id="@+id/label_author"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Author: "
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:padding="10dp"/>

        <!-- TextInputLayout wrapped around the AutoCompleteTextView for validation messages and prompts
             AutoCompleteTextView will populate with author name suggestions from author table-->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/author_input_layout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="10dp"
            app:hintEnabled="true"
            app:errorEnabled="true"
            android:paddingEnd="10dp">

            <AutoCompleteTextView
                android:id="@+id/author_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Author Name"
                android:textSize="20sp"
                android:inputType="text"
                android:gravity="end"
                android:completionThreshold="1"/>
        </com.google.android.material.textfield.TextInputLayout>
    </LinearLayout>

    <!-- Text view with an editable field for the Book Genre string
        Formatted so the EditText is aligned horizontally with the TextView -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:id="@+id/input_genre_field"
        app:layout_constraintTop_toBottomOf="@+id/input_author_field">

        <TextView
            android:id="@+id/label_book_genre"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Genre: "
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:padding="10dp"/>

        <!-- TextInputLayout wrapped around the AutoCompleteTextView for validation messages and prompts
             AutoCompleteTextView will populate with genre suggestions from book table-->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/book_genre_input_layout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="10dp"
            app:hintEnabled="true"
            android:paddingEnd="10dp">

            <AutoCompleteTextView
                android:id="@+id/book_genre_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Genre (Optional)"
                android:textSize="20sp"
                android:inputType="text"
                android:gravity="end"
                android:completionThreshold="1"/>
        </com.google.android.material.textfield.TextInputLayout>
    </LinearLayout>

    <!-- Text view with an editable field for the Book Genre string
    Formatted so the EditText is aligned horizontally with the TextView -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:id="@+id/input_date_field"
        app:layout_constraintTop_toBottomOf="@+id/input_genre_field">

        <TextView
            android:id="@+id/label_date_read"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Date Read: "
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:padding="10dp"/>

        <!-- TextInputLayout wrapped around the EditText for validation messages and prompts -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="Date (Optional)">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/date_read_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="20sp"
                android:focusable="false"
                android:clickable="true"
                android:inputType="none"
                android:gravity="end"
                android:layout_marginEnd="10dp"/>
        </com.google.android.material.textfield.TextInputLayout>
    </LinearLayout>

    <!-- Text view with a radio field for the isSeries Boolean
    Formatted so the Radio buttons are aligned horizontally with the TextView
    Formatted inside a Constraint Layout so the radio buttons are at the end of the line  -->
    <LinearLayout
        android:id="@+id/series_field"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintTop_toBottomOf="@+id/input_date_field"
        android:padding="10dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/label_series"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Series?"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/black"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

            <!-- Wrap the RadioGroup in a TextInputLayout -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/series_input_layout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:hint="Select Series"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent">

                <RadioGroup
                    android:id="@+id/series_radio_group"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    app:layout_constraintEnd_toEndOf="parent">

                    <RadioButton
                        android:id="@+id/series_yes"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Yes"
                        android:textSize="20sp" />

                    <RadioButton
                        android:id="@+id/series_no"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="No"
                        android:textSize="20sp"
                        android:checked="true"/>
                </RadioGroup>

            </com.google.android.material.textfield.TextInputLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </LinearLayout>

    <!-- Text view with an editable field for the Series Name string
        Formatted so the EditText is aligned horizontally with the TextView -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:id="@+id/input_series_name_field"
        app:layout_constraintTop_toBottomOf="@+id/series_field">

        <TextView
            android:id="@+id/label_series_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Series Name: "
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:padding="10dp"/>

        <!-- TextInputLayout wrapped around the AutoCompleteTextView for validation messages and prompts
             AutoCompleteTextView will populate with series name suggestions from book table-->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/series_name_input_layout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="10dp"
            app:hintEnabled="true"
            android:paddingEnd="10dp">

            <AutoCompleteTextView
                android:id="@+id/series_name_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Name (Optional)"
                android:textSize="20sp"
                android:inputType="text"
                android:gravity="end"
                android:completionThreshold="1"/>
        </com.google.android.material.textfield.TextInputLayout>
    </LinearLayout>

    <!-- Text view with an editable field for the Series Number string
        Formatted so the EditText is aligned horizontally with the TextView -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:id="@+id/input_series_number_field"
        app:layout_constraintTop_toBottomOf="@+id/input_series_name_field">

        <TextView
            android:id="@+id/label_series_number"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Book Number: "
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:padding="10dp"/>

        <!-- TextInputLayout wrapped around the EditText for validation messages and prompts -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/series_number_input_layout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="10dp"
            app:hintEnabled="true"
            android:paddingEnd="10dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/series_number_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Number (Optional)"
                android:textSize="20sp"
                android:inputType="numberDecimal"
                android:maxLength="5"
                android:gravity="end"/>
        </com.google.android.material.textfield.TextInputLayout>
    </LinearLayout>
    </LinearLayout>
</ScrollView>

    <!-- Button to add author to database -->
    <Button
        android:id="@+id/save_book_button"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="20dp"
        android:text="Save"
        android:textSize="30sp"
        android:textAllCaps="false"
        android:background="@drawable/rounded_button"
        android:elevation="4dp"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@+id/input_scroll_view"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>